rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // ---------------------------------------------------------
    // 1. Core Auth Checks
    // ---------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ---------------------------------------------------------
    // 2. Collection Rules
    // ---------------------------------------------------------

    // USERS & USER_STATS (Doc ID is User UID)
    match /users/{userId} {
      allow read, write: if isAdmin() || isOwner(userId);
    }
    match /userStats/{userId} {
      allow read, write: if isAdmin() || isOwner(userId);
    }

    // CHAT_SESSIONS (Top-level)
    match /chatSessions/{sessionId} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data.userId);
      allow create: if isAdmin() || isOwner(request.resource.data.userId);
      
      // MESSAGES (Subcollection inside chatSessions)
      match /messages/{messageId} {
        
        // Use this if your message document ALSO has a 'userId' field directly on it:
        allow read, update, delete: if isAdmin() || isOwner(resource.data.userId);
        allow create: if isAdmin() || isOwner(request.resource.data.userId);

        /* 
        // -------------------------------------------------------------------------
        // ONLY Use this logic instead if messages DON'T have a 'userId' field, 
        // and you need to look at the parent chatSession to see who owns it:
        // -------------------------------------------------------------------------
        allow read, write: if isAdmin() || 
          isOwner(get(/databases/$(database)/documents/chatSessions/$(sessionId)).data.userId);
        */
      }
    }

    // USAGE
    match /usage/{docId} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data.userId);
      allow create: if isAdmin() || isOwner(request.resource.data.userId);
    }

    // OTP
    match /otp/{docId} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data.userId);
      allow create: if isAdmin() || isOwner(request.resource.data.userId);
    }
    
    // Default Deny for anything else
    match /{document=**} {
      allow read, write: if false; 
    }
  }
}
