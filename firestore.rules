rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ---------------------------------------------------------
    // Helper Functions
    // ---------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Safely check if the user is an admin by verifying the document exists first
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' ||
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN'
             );
    }

    function isValidVoicePreference(preference) {
      return preference is map &&
             preference.keys().hasOnly(['preferedVoiceId', 'preferedVoiceName']) &&
             (!('preferedVoiceId' in preference) ||
               (preference.preferedVoiceId is string && preference.preferedVoiceId.size() <= 64)) &&
             (!('preferedVoiceName' in preference) ||
               (preference.preferedVoiceName is string && preference.preferedVoiceName.size() <= 120));
    }

    function isValidVoiceBuffer(data, docId) {
      return data.keys().hasOnly([
               'sessionId', 'userId', 'userName', 'preferedVoice',
               'duration', 'transcripts', 'updatedAt', 'status'
             ]) &&
             data.keys().hasAll([
               'sessionId', 'userId', 'userName', 'preferedVoice',
               'duration', 'updatedAt', 'status'
             ]) &&
             data.sessionId is string && data.sessionId == docId &&
             data.userId is string && data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() <= 120 &&
             isValidVoicePreference(data.preferedVoice) &&
             data.duration is int && data.duration >= 0 && data.duration <= 1800 &&
             (!('transcripts' in data) ||
               (data.transcripts is list && data.transcripts.size() <= 1000)) &&
             data.updatedAt is timestamp &&
             data.status == 'active';
    }

    function isValidVoiceRecordingUpdate(docId) {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['audioUrl', 'recordingStatus']) &&
             request.resource.data.userId == resource.data.userId &&
             (!('audioUrl' in request.resource.data) ||
               (request.resource.data.audioUrl is string &&
                request.resource.data.audioUrl.size() <= 4096 &&
                (request.resource.data.audioUrl.matches(
                   '^https://firebasestorage\\.googleapis\\.com/.*/o/storedFiles%2Fvoice-sessions%2F' +
                   request.auth.uid + '_' + docId + '\\.(wav|webm).*$'
                 ) ||
                 request.resource.data.audioUrl.matches(
                   '^https://storage\\.googleapis\\.com/.*/storedFiles/voice-sessions/' +
                   request.auth.uid + '_' + docId + '\\.(wav|webm).*$'
                 )))) &&
             (!('recordingStatus' in request.resource.data) ||
               request.resource.data.recordingStatus in ['PENDING', 'UPLOADING', 'READY', 'FAILED']);
    }

    // ---------------------------------------------------------
    // 1. Users & Core Authentication Data
    // ---------------------------------------------------------
    match /users/{userId} {
      // Users can read/write their own document, admins have full access
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /otp/{docId} {
      // OTPs are handled entirely by Next.js Server Actions (Firebase Admin SDK)
      // Client-side access is completely blocked.
      allow read, write: if false; 
    }

    // ---------------------------------------------------------
    // 2. Chat Sessions & Messages
    // ---------------------------------------------------------
    match /chatSessions/{sessionId} {
      // Must own the session being created
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      // Must own the existing session
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
      
      // Messages are a subcollection. Access depends on owning the parent session.
      match /messages/{messageId} {
        allow read, write: if isAdmin() || isOwner(get(/databases/$(database)/documents/chatSessions/$(sessionId)).data.userId);
      }
    }

    // ---------------------------------------------------------
    // 3. Support Tickets & Messaging
    // ---------------------------------------------------------
    match /supportTickets/{ticketId} {
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /supportMessages/{msgId} {
      // Support messages are top-level and reference a ticketId.
      allow read: if isAdmin() || isOwner(get(/databases/$(database)/documents/supportTickets/$(resource.data.ticketId)).data.userId);
      
      // Can only create if senderId matches uid AND the user owns the ticket (or is Admin)
      allow create: if isAdmin() || (
        isOwner(request.resource.data.senderId) && 
        isOwner(get(/databases/$(database)/documents/supportTickets/$(request.resource.data.ticketId)).data.userId)
      );
      
      // Users cannot edit or delete support messages
      allow update, delete: if isAdmin();
    }

    match /helpArticles/{articleId} {
      // Publicly readable for all users
      allow read: if true; 
      // Only admins can modify help articles
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------
    // 4. Voice, Documents & Usage tracking
    // ---------------------------------------------------------
    // All these collections inherently contain a `userId` field to restrict access
    match /usage/{docId} {
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
    match /userStats/{docId} {
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
    match /transactions/{docId} {
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
    match /notifications/{docId} {
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
    match /voiceSessions/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
                    (isOwner(resource.data.userId) && isValidVoiceRecordingUpdate(docId));
    }
    match /voiceSessionBuffers/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAdmin() ||
                    (isOwner(request.resource.data.userId) &&
                     isValidVoiceBuffer(request.resource.data, docId));
      allow update: if isAdmin() ||
                    (isOwner(resource.data.userId) &&
                     request.resource.data.userId == resource.data.userId &&
                     isValidVoiceBuffer(request.resource.data, docId));
      allow delete: if isAdmin();
    }
    match /transcriptions/{docId} {
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
    match /fcmTokens/{docId} {
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
    match /freeCreditHistory/{docId} {
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
    match /documentReviews/{docId} {
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ---------------------------------------------------------
    // 5. System Config & Admin Only Access
    // ---------------------------------------------------------
    // These collections are restricted to Admins for client-side access.
    // Next.js Server Actions bypass these rules anyway using the Admin SDK.
    match /systemConfig/{docId} {
      allow read, write: if isAdmin();
    }
    match /systemConfigAudits/{docId} {
      allow read, write: if isAdmin();
    }
    match /proccessedTransactions/{docId} {
      allow read, write: if isAdmin();
    }
    match /analytics/{docId} {
      allow read, write: if isAdmin();
    }
    match /pendingSignups/{docId} {
      allow read, write: if false; 
    }
    match /rateLimits/{docId} {
      allow read, write: if false; 
    }
    match /outbox/{docId} {
      allow read, write: if false; 
    }
  }
}
